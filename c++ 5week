#include <iostream>
#include <vector>
#include <string>
using namespace std;

class Information {
private:
    string title;
    string author;
public:
    Information(string t, string a) : title(t), author(a) {}
    string getTitle() { return title; }
    string getAuthor() { return author; }
    void setTitle(string t) { title = t; }
    void setAuthor(string a) { author = a; }
};

bool isSameBook(Information* info, string title, string author) {
    return (info->getTitle() == title && info->getAuthor() == author);
}

int main() {
    vector<Information> books;
    int choice;

    while (true) {
        cout << "***** 도서 정보 관리 프로그램 *****" << endl;
        cout << "1. 도서 추가" << endl;
        cout << "2. 도서 검색" << endl;
        cout << "3. 도서 정보 수정" << endl;
        cout << "4. 프로그램 종료" << endl;
        cout << "번호를 입력하세요: ";
        cin >> choice;
        cin.ignore();  

        if (choice == 1) {
            cout << "***** 도서 추가를 진행합니다 *****" << endl;
            string title, author;
            cout << "도서 제목을 입력하세요: ";
            getline(cin, title);
            cout << "도서 저자를 입력하세요: ";
            getline(cin, author);

            bool exists = false;
            for (int i = 0; i < books.size(); i++) {
                if (isSameBook(&books[i], title, author)) {
                    exists = true;
                    break;
                }
            }

            if (exists) {
                cout << "이미 등록된 도서입니다." << endl;
            } else {
                books.push_back(Information(title, author));
                cout << "도서가 성공적으로 추가되었습니다." << endl;
            }
        }

        else if (choice == 2) {
            cout << "***** 도서 검색을 진행합니다 *****" << endl;
            string title, author;
            cout << "도서 제목을 입력하세요: ";
            getline(cin, title);
            cout << "도서 저자를 입력하세요: ";
            getline(cin, author);

            bool found = false;
            for (int i = 0; i < books.size(); i++) {
                if (isSameBook(&books[i], title, author)) {
                    cout << "도서를 찾았습니다." << endl;
                    cout << "제목: " << books[i].getTitle() << endl;
                    cout << "저자: " << books[i].getAuthor() << endl;
                    found = true;
                    break;
                }
            }
            if (!found) {
                cout << "일치하는 도서를 찾을 수 없습니다." << endl;
            }
        }

        else if (choice == 3) {
            cout << "***** 도서 정보를 수정합니다 *****" << endl;
            string oldTitle, oldAuthor;
            cout << "수정할 도서 제목을 입력하세요: ";
            getline(cin, oldTitle);
            cout << "수정할 도서 저자를 입력하세요: ";
            getline(cin, oldAuthor);

            bool modified = false;
            for (int i = 0; i < books.size(); i++) {
                if (isSameBook(&books[i], oldTitle, oldAuthor)) {
                    string newTitle, newAuthor;
                    cout << "새로운 도서 제목을 입력하세요: ";
                    getline(cin, newTitle);
                    cout << "새로운 도서 저자를 입력하세요: ";
                    getline(cin, newAuthor);
                    books[i].setTitle(newTitle);
                    books[i].setAuthor(newAuthor);
                    cout << "도서 정보가 성공적으로 수정되었습니다." << endl;
                    modified = true;
                    break;
                }
            }
            if (!modified) {
                cout << "일치하는 도서를 찾을 수 없습니다." << endl;
            }
        }

        else if (choice == 4) {
            cout << "프로그램을 종료합니다." << endl;
            break;
        }

        else {
            cout << "정확한 번호를 입력하세요." << endl;
        }

        cout << endl;
    }

    return 0;
}
